# --- Server ---
PORT=3000

# --- Timezone used for "today", date parsing and the daily digest schedule ---
TIMEZONE=Europe/Amsterdam

# --- Twilio (WhatsApp) ---
# From https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default is whatsapp:+14155238886, replace once you have your own WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your own phone number, in E.164 format, e.g. +316xxxxxxxx
MY_PHONE_NUMBER=

# --- Google Calendar ---
# From https://console.cloud.google.com (OAuth client, type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated once via `npm run token`
GOOGLE_REFRESH_TOKEN=
# "primary" for your main calendar, or a specific calendar ID
GOOGLE_CALENDAR_ID=primary

# --- Daily digest ---
# Cron expression, evaluated in TIMEZONE above. Default: 07:30 every day.
DAILY_DIGEST_CRON=30 7 * * *
# Default duration (minutes) for appointments added without an explicit end time
DEFAULT_EVENT_DURATION_MINUTES=60
