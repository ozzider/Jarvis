# Kopieer dit bestand naar ".env" en vul je eigen sleutel in.
# Je sleutel maak je aan op https://platform.claude.com (API Keys).
# Let op: .env komt NOOIT op GitHub (staat in .gitignore).
ANTHROPIC_API_KEY=

# Welk Claude-model de agents gebruiken
CLAUDE_MODEL=claude-opus-5-5

# Poort van de webserver (http://localhost:3000)
PORT=3000
